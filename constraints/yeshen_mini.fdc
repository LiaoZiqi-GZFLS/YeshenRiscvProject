# ===== 板载时钟输入 27MHz：D18（官方 4_10 sys_clk / 2_7·2_8 clk；
#       手册 P13-14 核心板 27M 晶振 = FPGA_GCLK_27M = D18）。待实测复核。
define_attribute {p:clk_in} {PAP_IO_DIRECTION} {INPUT}
