###==== END Io Table

# ===== 以太网 PHY0（RGMII，第三装载器）：端口与属性逐条取自厂家 2_11 例程的 fdc
#       （仅把 rgmii_* 改名为 eth_rgmii_*、phy_rstn 改名为 eth_phy_rstn）=====
# 时钟（125MHz RGMII）：先建钟，后面的属性/约束才能引用
create_clock -name {eth_rgmii_rxc} [get_ports {eth_rgmii_rxc}] -period {8.000} -waveform {0.000 4.000}
create_clock -name {eth_rgmii_txc} [get_ports {eth_rgmii_txc}] -period {8.000} -waveform {0.000 4.000}

# ★ 2026-10-06（LiteEth 落地）：`board/liteeth_wrap.v` 的 `u_rgmii.GTP_CLKBUFG_RXSHFT`
#   把 RXC 缓冲成织内时钟 `rgmii_clk`，**LiteEth MAC 的 PHY 侧（eth_rx/eth_tx 两个域）就跑在它上面**
#   （`liteeth_mac_top.clock_pads_rx/tx` = rgmii_clk）。它是 RXC 的 1:1 派生钟 ⇒ 必须建"派生钟"，
#   否则那两个域里的寄存器**没有时钟对象** ⇒ 整段不受时序约束（且报告里会出现未约束路径）。
#   ⚠️ 必须排在 `create_clock {eth_rgmii_rxc}` **之后**：本文件顺序执行，引用在前=空集=被静默丢弃。
# ⚠️ 实例路径必须**从顶层起**（层级用 `.`、叶子脚用 `/`）—— `u_liteeth` 在 `yeshen_mini_soc` 里，
#    而 `yeshen_mini_soc` 在顶层 `yeshen_mini_board_top` 里叫 `u_soc` ⇒ 全路径带 `u_soc.` 前缀。
#    （第一版漏了这个前缀，PDS 报 `Timing-4003 Pin ... is not found` + `Nothing matched for 'source_list'`。）
# ⚠️⚠️ `-multiply_by/-divide_by` **必须显式写**（照抄上面 DDR 那几条派生钟的写法）：
#    不写时 PDS **不会**继承 master 的周期，而是给一个默认的 **1000 ns / 1 MHz**
#    —— 实测：产物 Clock Summary 里 `rgmii_clk 1000.0000`、Slack 997（= 那 28 个端点等于**没约束**），
#    而日志里**一句报错都没有**（只有正常的 `Generated (eth_rgmii_rxc)`）。1:1 就写 1/1。
create_generated_clock -name {rgmii_clk} -source [get_ports {eth_rgmii_rxc}] [get_pins {u_soc.u_liteeth.u_rgmii.GTP_CLKBUFG_RXSHFT/CLKOUT}] -master_clock [get_clocks {eth_rgmii_rxc}] -multiply_by {1} -divide_by {1}

# ★ 100MHz 的 `soc_clk`（板级 PLL）与 125MHz 的 `rgmii_clk`（PHY 的 RXC）**彼此异步**：
#   两者之间的跨越**全部**由 LiteEth MAC 内部那段异步 FIFO（gray 码指针，见
#   `third_party/liteeth_mac/liteeth_mac_top.v` 的 asyncfifo*/graycounter*）承担 ⇒ 声明异步组，
#   别让工具去"修"这些结构上就不该被修的路。同样必须排在两个钟都建好之后。
set_clock_groups -asynchronous -group [get_clocks {soc_clk}] -group [get_clocks {rgmii_clk}]

# =============================================================================
# ★ V1b（2026-10-27）：CAM1（camera_clk_1 / cam_pixel_clk_1）异步组
# -----------------------------------------------------------------------------
# **位置约束（不是风格问题）**：本文件顺序执行，`get_clocks {…}` 在钟定义之前求值 = 空集
#   ⇒ 该条 set_clock_groups 被**静默丢弃**（日志里一句报错都没有）。本文件最后一批
#   `create_clock` 是上面 eth 段的 `eth_rgmii_rxc/txc`（:1342-1343），故本段**必须**排在这里；
#   两座新钟本身在 :231-236 的时钟段里创建（紧跟 cam_pixel_clk，写法与 ①② 逐行同构）。
# 写法逐条照既有 :292-308 的相机/LCD 段：每座新钟一条 `-name … -group` singleton，
#   再与各既有钟两两互列。
# 物理依据：camera_clk_1 是**板外 CAM1 模组**的 PCLK（J10 球 M21），与 camera_clk_0、板载 27MHz、
#   各颗 PLL 都不同源 ⇒ 两路相机钟**必须**互为异步组（`sel` 在 clk0/clk1 之间是**故意的 2FF
#   异步穿越**，绝不能当同步域分析）。
# cam_pixel_clk_1 = 第二套 cmos16 的输出脚上由 camera_clk_1 派生的 ÷2 钟（独立脚，无需 `-add`）。
# camwr_clk = cam_switch 对两路 pixel_clk 的无毛刺 mux 输出（写侧唯一时钟）。它物理上要么是
#   cam_pixel_clk、要么是 cam_pixel_clk_1；约束上按 camera_clk_0 ÷2 声明，故与 CAM0 那侧
#   保持"同步"（工具会连 LUT 门控延迟一起算，20ns 周期足够），与 CAM1 那侧互列异步。
# =============================================================================
set_clock_groups -name camera_clk_1 -asynchronous -group [get_clocks {camera_clk_1}]
set_clock_groups -name cam_pixel_clk_1 -asynchronous -group [get_clocks {cam_pixel_clk_1}]
set_clock_groups -asynchronous -group [get_clocks {cam_pixel_clk_1}] -group [get_clocks {camwr_clk}]
set_clock_groups -asynchronous -group [get_clocks {camera_clk_1}]   -group [get_clocks {camwr_clk}]
set_clock_groups -asynchronous -group [get_clocks {camera_clk_0}]   -group [get_clocks {camwr_clk}]
set_clock_groups -asynchronous -group [get_clocks {cam_pixel_clk}]  -group [get_clocks {camwr_clk}]
set_clock_groups -asynchronous -group [get_clocks {camwr_clk}] -group [get_clocks {soc_clk}]
set_clock_groups -asynchronous -group [get_clocks {camwr_clk}] -group [get_clocks {cpu_clk}]
set_clock_groups -asynchronous -group [get_clocks {camwr_clk}] -group [get_clocks {npu_clk}]
set_clock_groups -asynchronous -group [get_clocks {camwr_clk}] -group [get_clocks {core_clk}]
set_clock_groups -asynchronous -group [get_clocks {camwr_clk}] -group [get_clocks {clk_in}]
set_clock_groups -asynchronous -group [get_clocks {camwr_clk}] -group [get_clocks {ref_clk}]
set_clock_groups -asynchronous -group [get_clocks {camwr_clk}] -group [get_clocks {lcd_clk}]
set_clock_groups -asynchronous -group [get_clocks {camwr_clk}] -group [get_clocks {rgmii_clk}]
set_clock_groups -asynchronous -group [get_clocks {camera_clk_0}] -group [get_clocks {camera_clk_1}]
set_clock_groups -asynchronous -group [get_clocks {cam_pixel_clk}]  -group [get_clocks {camera_clk_1}]
set_clock_groups -asynchronous -group [get_clocks {camera_clk_1}]   -group [get_clocks {cam_pixel_clk_1}]
set_clock_groups -asynchronous -group [get_clocks {camera_clk_1}]   -group [get_clocks {lcd_clk}]
set_clock_groups -asynchronous -group [get_clocks {camera_clk_1}]   -group [get_clocks {soc_clk}]
