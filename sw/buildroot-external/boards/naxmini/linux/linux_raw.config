CONFIG_SECTION_MISMATCH_WARN_ONLY=y

## Architecture
CONFIG_ARCH_DEFCONFIG="arch/riscv/configs/defconfig"
#ifdef RV32
CONFIG_ARCH_RV32I=y
## RV32 + DRAM base 0x8000_0000 (RAM does not start at 0) => NONPORTABLE is REQUIRED:
## the kernel direct-map / page-table layout must assume RAM is not at 0.
## Same profile as the upstream VexiiRiscv/NaxSoftware rv32 flow.
CONFIG_NONPORTABLE=y
#endif
#ifdef RV64
CONFIG_ARCH_RV64I=y
#endif
CONFIG_RISCV_ISA_M=y
CONFIG_RISCV_ISA_A=y
CONFIG_RISCV_ISA_C=RVC
CONFIG_SIFIVE_PLIC=y
#ifdef FPU
CONFIG_FPU=y
#else
CONFIG_FPU=n
#endif
CONFIG_SMP=y
CONFIG_STRICT_KERNEL_RWX=n
CONFIG_EFI=n
CONFIG_HVC_RISCV_SBI=y

CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=y
CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
CONFIG_RD_LZO=y
CONFIG_RD_LZ4=y

## Time
CONFIG_PRINTK_TIME=y
## Timers（K1，2026-10-29 对照实验：tickless + hrtimers，抢占仍为 NONE）
## CONFIG_HZ_PERIODIC is not set
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
## K2（在 K1 之上再开全抢占）
CONFIG_PREEMPT=y

## Interrupts
CONFIG_IRQCHIP=y
CONFIG_OF_IRQ=y

## Ethernet
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=y
CONFIG_INET=y
CONFIG_NETDEVICES=y

## Serial
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
## ★ 2026-10-02：8250 串口驱动。缺它 ⇒ 没有 ttyS0 ⇒ 内核报
##   "Warning: unable to open an initial console" ⇒ /init 自己开控制台时写不出去
##   ⇒ P1 判据 NAXMINI-USPACE-OK 永远打印不出来。
##   DT 里本来就有 serial@f0001000 { compatible = "ns16550a"; } 且 chosen/stdout-path 指向它，
##   所以只差这一组驱动开关（纯配置缺口，不是缺陷）。
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

CONFIG_EXT2_FS=y
CONFIG_EXT3_FS=y
CONFIG_EXT4_FS=y

## .config in kernel
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

## Filesystem
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NCPFS_SMALLDOS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y

## LiteEth: nax/LiteX ecosystem NIC. Driver comes from the external-tree kernel patch
CONFIG_OF_NET=y
CONFIG_NET_VENDOR_LITEX=y
CONFIG_LITEX_LITEETH=y

## ★ 2026-10-29：软件 `reboot`（syscon-reboot -> video_regs.RST_CTRL -> 20 ms SoC 复位）
##   · MFD_SYSCON 提供 "syscon" 兼容串 + regmap（靠它才能拿到 VIDEO 窗的 regmap）
##   · POWER_RESET_SYSCON 提供 "syscon-reboot"（写一次 value 然后 mdelay(50)）
##   三者缺一，DT 里的 reboot 节点就是死的：内核敲 reboot 只会走到
##   `machine_restart` 的死等（"Reboot failed -- System halted"）。
CONFIG_POWER_RESET=y
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET_SYSCON=y
## ============================================================================
## ★ 2026-10-30：GT911 电容触摸（CTP 从 YeshenGuiTouch 搬进主线）
##   DT 侧见 linux_raw.dts 的 gpio@f0002000 / i2c-ctp / touchscreen@14；
##   驱动侧：
##     · GPIO_YESHEN_CTP —— 胶合块 0xF000_2000 那个 13 线 GPIO 的 gpiochip 驱动，
##       由 patches/linux/0003-* 打进内核树（drivers/gpio/gpio-yeshen-ctp.c）。
##     · I2C_GPIO —— 用上面两根 GPIO 位操作出 I2C 总线（面板 SCL 无上拉 ⇒ SCL 推挽）。
##     · TOUCHSCREEN_GOODIX + INPUT_EVDEV —— 主线 goodix 驱动 + evdev 给 userspace。
##   ⚠️ 这几个符号原配置里**一个都没有**（早期最小化配置），靠 olddefconfig 补
##     依赖；构建后要回读 .config 确认全部 =y（脚本 build_images.sh 会打印生效项）。
## ============================================================================
CONFIG_GPIOLIB=y
CONFIG_OF_GPIO=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_YESHEN_CTP=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_GPIO=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y
