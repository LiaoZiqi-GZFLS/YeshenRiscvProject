# OpenSBI
# Task 22 NOTE: BR2_TARGET_OPENSBI_PLAT / _PLAT_PATH still exist and are unchanged
# (PLAT is a buildroot option; PLAT_PATH is OUR external-tree symbol driving the
# copy hook in package/opensbi-ext/opensbi-ext.mk). What changed is on the OpenSBI
# side (1.6): the platform dir now needs Kconfig + configs/defconfig + objects.mk,
# and the old config.mk is pulled in by an -include line in objects.mk. See
# boards/naxmini/opensbi/ and the Task 22 section of the probe record doc.
BR2_TARGET_OPENSBI=y
# OpenSBI pinned to 1.6: the out-of-tree platform.c is written against the v1.6 ABI;
# buildroot 2026.02 defaults to 1.7, which fails to compile it
# ("control reaches end of non-void function", uart8250_init signature drift).
BR2_TARGET_OPENSBI_CUSTOM_VERSION=y
BR2_TARGET_OPENSBI_CUSTOM_VERSION_VALUE="1.6"
BR2_TARGET_OPENSBI_PLAT="out-of-tree"
BR2_TARGET_OPENSBI_PLAT_PATH="$(BR2_EXTERNAL_NAXMINI_PATH)/boards/naxmini/opensbi"
# Filesystem
BR2_TARGET_ROOTFS_CPIO=y
# Kernel 6.18 (mainline tarball). Generated by hand from naxmini_defconfig;
# NOTE: requires buildroot >= 2026.02 (it is the first series with kernel-headers 6.18).
# 2025.02 tops out at 6.12 and would fail the strict headers check.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.60.tar.xz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_NAXMINI_PATH)/boards/naxmini/linux/linux618.config"
BR2_LINUX_KERNEL_IMAGE=y
# Rootfs customisation
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_NAXMINI_PATH)/boards/naxmini/linux/rootfs_overlay"
# Extra packages
BR2_PACKAGE_DHRYSTONE=y
BR2_PACKAGE_MICROPYTHON=y
